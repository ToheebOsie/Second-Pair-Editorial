# Public site URL — set this to the final HTTPS production domain.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Public contact email shown in metadata and business information.
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# Resend API key for server-side email delivery
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that receives manuscript sample requests
ADMIN_EMAIL=you@example.com

# Verified sender address/domain in Resend
FROM_EMAIL=Second Pair Editorial <hello@yourdomain.com>

# Phase 1 private onboarding token. Set a long random value and send the
# onboarding URL manually only after the required starting payment is confirmed.
ONBOARDING_ACCESS_TOKEN=replace-with-a-long-random-token
